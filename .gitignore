# Python virtual environment
.venv/
venv/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Node.js & Next.js web application
web/node_modules/
web/.next/
web/out/
web/.vercel/
web/*.tsbuildinfo

# CodeSage generated model caches & local embedding binaries
data/cache/
.cache/
models/
*.npy
*.npz
*.pt
*.bin
*.onnx

# Allow tracking evaluation queries, code unit dataset, and experimental reports
!data/
!data/evaluation_queries.jsonl
!data/code_units.jsonl
!data/relationship_graph.json
!data/manifest.json
!data/experiments/
!data/benchmark_comparison.json
!data/benchmark_comparison.csv

# Secrets, keys, and credentials
.env
.env.*
*.key
*.pem
*.cert
*.p12

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
